# Ghost Content API
# Ghost Admin -> Settings -> Integrations -> Add custom integration
# Copy the "Content API Key" and your Ghost site URL below.
GHOST_URL=https://your-ghost-site.com
GHOST_CONTENT_API_KEY=your_content_api_key

# Public URL where this site is served (used for RSS + sitemap absolute links)
SITE_URL=https://aether.example.com

# Leave GHOST_URL / GHOST_CONTENT_API_KEY unset to run against built-in sample
# content (no Ghost connection required).
