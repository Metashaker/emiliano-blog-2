---
import type { Post } from '../lib/ghost';
import { useTranslations } from '../i18n/ui';
import { formatDate } from '../lib/format';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const t = useTranslations(post.lang);
---
<li class="post-card reveal">
  <a href={`/${post.lang}/${post.slug}/`}>
    <div class="meta">
      <time datetime={post.publishedAt}>{formatDate(post.publishedAt, post.lang)}</time>
      {post.readingTime && <span>{post.readingTime} {t('post.readingTime')}</span>}
    </div>
    <h2>{post.title}</h2>
    <p>{post.excerpt}</p>
  </a>
</li>
