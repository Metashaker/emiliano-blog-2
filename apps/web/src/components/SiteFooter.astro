---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;
---
<footer class="site-footer">
  <div class="wrap">
    <span>© {year} {t('site.title')} — {t('footer.rights')}</span>
    <span>Ghost · Astro · Cloudflare</span>
  </div>
</footer>
